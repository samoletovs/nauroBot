# nauroBot — Function App settings. Real values live in Azure app settings, never here.
# Copy to functions/local.settings.json (wrapped under "Values") for local runs.

# The NauroLabs ops bot token (shared with autoRefine, which sends the idea cards).
NAURO_BOT_TOKEN=

# Secret token registered with Telegram setWebhook; verified on every request.
TELEGRAM_WEBHOOK_SECRET=

# Only updates from this chat are honoured (empty = allow any).
NAURO_CHAT_ID=

# User PAT (classic, repo scope) to relabel/close issues and assign the Copilot agent.
GH_ASSIGN_PAT=

# GitHub owner for NauroLabs project repos.
NAURO_GITHUB_OWNER=samoletovs
